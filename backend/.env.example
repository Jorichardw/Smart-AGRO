# AGRO-BOT & AUTOMATION - Environment Configuration
# Copy this file to .env and fill in your values

# Basic Configuration
PROJECT_NAME="AGRO-BOT & AUTOMATION"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true

# Security
SECRET_KEY="your-super-secret-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=11520
REFRESH_TOKEN_EXPIRE_MINUTES=43200

# Database
DATABASE_URL="postgresql://agro_user:agro_password@localhost:5432/agro_bot_db"
DATABASE_ECHO=false

# Redis
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""

# Firebase Configuration
FIREBASE_PROJECT_ID="agro-bot-automation"
FIREBASE_PRIVATE_KEY_ID=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_CLIENT_ID=""
FIREBASE_STORAGE_BUCKET="agro-bot-automation.appspot.com"

# AI Services
AI_SERVICE_URL="http://localhost:8001"
AI_API_KEY="agro-bot-ai-api-key"

# Weather API
WEATHER_API_KEY="your-openweathermap-api-key"
WEATHER_API_URL="https://api.openweathermap.org/data/2.5"

# SMS Configuration (Twilio)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Email Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
EMAIL_FROM="noreply@agro-bot.com"

# Payment Gateway (Stripe)
STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# AWS Configuration
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET="agro-bot-files"

# Google Cloud
GOOGLE_CLOUD_PROJECT="agro-bot-automation"
GOOGLE_APPLICATION_CREDENTIALS="firebase-config.json"

# IoT Configuration
IOT_BROKER_HOST="localhost"
IOT_BROKER_PORT=1883
IOT_BROKER_USERNAME="agro_iot"
IOT_BROKER_PASSWORD="iot_password"

# Celery
CELERY_BROKER_URL="redis://localhost:6379"
CELERY_RESULT_BACKEND="redis://localhost:6379"

# Monitoring
SENTRY_DSN=""

# Feature Flags
ENABLE_AI_FEATURES=true
ENABLE_IOT_FEATURES=true
ENABLE_MARKETPLACE=true
ENABLE_CHAT_ASSISTANT=true
ENABLE_NOTIFICATIONS=true